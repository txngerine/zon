{
  "manifest_version": 3,
  "name": "Send to ZON",
  "version": "1.0.0",
  "description": "Send links, videos and pages to the ZON download manager.",
  "permissions": ["contextMenus", "downloads", "storage"],
  "host_permissions": ["http://127.0.0.1:6412/*"],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "Send this page to ZON",
    "default_icon": { "16": "icon16.png", "32": "icon32.png" }
  },
  "options_ui": { "page": "options.html", "open_in_tab": false },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "browser_specific_settings": {
    "gecko": { "id": "send-to-zon@zon.dev", "strict_min_version": "121.0" }
  }
}
